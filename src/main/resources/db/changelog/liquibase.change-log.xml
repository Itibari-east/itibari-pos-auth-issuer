    <changeSet id="pos-auth-issuer-auth-users" author="enock">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="auth_users" schemaName="pos_core"/>
            </not>
        </preConditions>
        <createTable tableName="auth_users" schemaName="pos_core">
            <column name="id" autoIncrement="true" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="auth_users_pkey"/>
            </column>
            <column name="public_id" type="uuid"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false"/>
            <column name="creation_time" type="timestamp"/>
            <column name="last_modified_date" type="timestamp"/>
            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="varchar(255)"/>
            <column name="last_name" type="varchar(255)"/>
            <column name="phone_number" type="varchar(255)"/>
            <column name="email" type="varchar(255)"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true"/>
            <column name="active_status" type="boolean" defaultValueBoolean="true"/>
            <column name="account_non_expired" type="boolean" defaultValueBoolean="true"/>
            <column name="credentials_non_expired" type="boolean" defaultValueBoolean="true"/>
            <column name="account_non_locked" type="boolean" defaultValueBoolean="true"/>
            <column name="admin" type="boolean" defaultValueBoolean="false"/>
            <column name="force_password_reset" type="boolean" defaultValueBoolean="false"/>
            <column name="accepted_terms" type="boolean" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

